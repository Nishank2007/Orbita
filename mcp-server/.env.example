# Base URL of the Node.js Schedule API (running on port 5000)
NODE_API_BASE_URL=http://localhost:5000

# MCP Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Agent Configuration (Streamable HTTP URL to MCP Server)
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Agent Mode: 'mock', 'auto', or 'live'
AGENT_MODE=auto

# Optional LLM Provider API Key (Gemini) - Leave empty for deterministic mock mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
